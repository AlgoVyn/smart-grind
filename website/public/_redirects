# Handle the /smartgrind/ prefix by stripping it for static assets
/smartgrind/assets/* /assets/:splat 200
/smartgrind/logo.svg /logo.svg 200
/smartgrind/manifest.json /manifest.json 200

# Only rewrite markdown files — extensionless /patterns/foo (etc.) must reach
# the SPA so hard-refresh deep links work. After the algovyn-proxy Worker
# strips /smartgrind, the Pages Function serves the same routes.
/smartgrind/solutions/:name.md /solutions/:name.md 200
/smartgrind/patterns/:name.md /patterns/:name.md 200
/smartgrind/algorithms/:name.md /algorithms/:name.md 200
/smartgrind/flashcards/:name.md /flashcards/:name.md 200
/smartgrind/sql/solutions/:name.md /sql/solutions/:name.md 200
/smartgrind/sql/patterns/:name.md /sql/patterns/:name.md 200

# Service Worker - explicit rule to prevent wildcard catch
# This ensures sw.js is served as a static file, not redirected to index.html
/smartgrind/sw.js /smartgrind/sw.js 200

# Directory-level fallbacks
/smartgrind/solutions /solutions/ 200
/smartgrind/patterns /patterns/ 200
/smartgrind/algorithms /algorithms/ 200
/smartgrind/flashcards /flashcards/ 200
/smartgrind/sql/solutions /sql/solutions/ 200
/smartgrind/sql/patterns /sql/patterns/ 200

# SEO fragments read by the SSR Function through the ASSETS binding.
# Keep them ahead of the SPA fallbacks so they are served as files, not index.html.
/seo/* /seo/:splat 200
/smartgrind/seo/* /seo/:splat 200

# SPA fallback: all other /smartgrind/ paths → index.html
/smartgrind/* /index.html 200

# Global SPA fallback
/* /index.html 200
