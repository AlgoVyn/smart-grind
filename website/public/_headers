# MIME type configuration for Cloudflare Pages
# Ensure JS and CSS are served correctly
# (Vite handles most of this, but good to have safety)

/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-QovWu9otHSj5Uu1QIClQfOocK1Ub4hITj04JcwpKRhc=' 'sha256-Itqb2IM/hP8Nkag3S5cHpTkYdAnWNDc+8A17whR+nWE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://algovyn.com data: blob:; connect-src 'self' https://algovyn.com https://leetcode.com https://fonts.googleapis.com https://static.cloudflareinsights.com; frame-src https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

/*.js
  Content-Type: application/javascript

/*.json
  Content-Type: application/json

/*.css
  Content-Type: text/css

/*.svg
  Content-Type: image/svg+xml

/*.md
  Content-Type: text/markdown
  Cache-Control: public, max-age=86400

/sql/**/*.md
  Content-Type: text/markdown
  Cache-Control: public, max-age=86400

/flashcards/*.md
  Content-Type: text/markdown
  Cache-Control: public, max-age=86400, s-maxage=31536000

# Service Worker headers - critical for SW to work properly
# The SW is now at /smartgrind/sw.js with correct scope
/smartgrind/sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
